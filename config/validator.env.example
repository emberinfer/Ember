EMBER_VALIDATOR_HOME=/srv/ember/validator
EMBER_VALIDATOR_P2P=tcp://0.0.0.0:26656
EMBER_VALIDATOR_RPC=tcp://127.0.0.1:26657
EMBER_VALIDATOR_METRICS=127.0.0.1:26660
EMBER_VALIDATOR_PEERS=

# start reads the following sections from $EMBER_VALIDATOR_HOME/config/config.toml.
# Snapshot supply is independent of state-sync consumption. Default: supply off.
# [snapshots]
# interval = 1000
# keep_recent = 2
#
# Enable consumption ONLY on a new home with the genuine pinned genesis and
# independently verified recent HEADER hash. Supply two independent RPC servers
# and reachable snapshot peers in EMBER_VALIDATOR_PEERS above.
# [statesync]
# enable = true
# rpc_servers = "https://rpc-a.example.org,https://rpc-b.example.org"
# trust_height = 123456
# trust_hash = "REPLACE_WITH_64_HEX_CHARACTERS_OF_VERIFIED_HEADER_HASH"
# trust_period = "168h0m0s"
# discovery_time = "15s"
# chunk_request_timeout = "10s"
# chunk_fetchers = 4
# temp_dir = ""
# Expired/mismatched anchors and malformed sync/snapshot configuration abort start.
