EMBER_GATEWAY_HTTP=127.0.0.1:19090
EMBER_GATEWAY_GRPC=0.0.0.0:19091
EMBER_CHAIN_RPC=http://127.0.0.1:26657
EMBER_LEDGER_CHAIN_ID=ember-public-testnet
EMBER_COORDINATOR_KEY=/srv/ember/keys/coordinator.key
EMBER_AUDITOR_KEY=/srv/ember/keys/auditor.key
EMBER_AUTH_FILE=/srv/ember/keys/auth.json
EMBER_TLS_CERT=/srv/ember/tls/seed.crt
EMBER_TLS_KEY=/srv/ember/tls/seed.key
EMBER_MODEL_GENESIS=/srv/ember/profiles/genesis.pb
EMBER_MODEL_MANIFEST=/srv/ember/profiles/manifest.pb
EMBER_MODEL_PATH=/srv/models/Qwen2.5-1.5B-Instruct
EMBER_AUDITOR_PYTHON=/srv/ember/venv/bin/python
EMBER_AUDITOR_PYTHONPATH=/srv/ember/lib/ember/core-py:/srv/ember/lib/ember/proto:/srv/ember/lib/ember/node
EMBER_AUDIT_DEVICE=cpu
EMBER_REQUEST_TIMEOUT=15m
EMBER_MAX_CONCURRENT=8
EMBER_AUDIT_WORKERS=2
EMBER_AUDIT_TIMEOUT=3m
# Testnet only. Spark issued here is valueless test credit.
# Separate faucet-only bind, e.g. 0.0.0.0:19092 at public testnet launch.
# Keep EMBER_GATEWAY_HTTP private; terminate HTTPS at the public edge.
EMBER_FAUCET_HTTP=
EMBER_FAUCET_KEY=
EMBER_FAUCET_AMOUNT=
EMBER_FAUCET_STATE=/srv/ember/state/faucet.json
EMBER_FAUCET_WINDOW=24h

# Empty uses conservative trust: historical anchors or a governor endorsement.
# JSON: {"profiles":{"PROFILE_ID":{"min_endorsers":2}}}
EMBER_PROFILE_TRUST_POLICY=
