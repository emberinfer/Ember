EMBER_COORDINATOR=seed.example:19091
EMBER_TLS_FINGERPRINT=replace-with-64-hex-digits
EMBER_MODEL_CHAIN=ember-qwen2.5-1.5b-s22-cpu-v1
EMBER_MODEL_PATH=/srv/models/Qwen2.5-1.5B-Instruct
EMBER_DEVICE=cpu
EMBER_SCHEDULER_ID=replace-with-on-chain-account-id
EMBER_CHAIN_RPC=http://127.0.0.1:26657
EMBER_LEDGER_CHAIN_ID=ember-s23-staging
EMBER_GENESIS_SHA256=replace-with-64-hex-digits
EMBER_MANIFEST_SHA256=replace-with-64-hex-digits
# Pinned layout scheme hash (64 hex), required when the profile manifest
# declares layout schemes. ember-role forwards it as --scheme-hash;
# ember-node join also reads it from the environment (flag wins).
EMBER_SCHEME_HASH=
# Blocks, capped by the chain parameter. Stop serving does not end registration.
EMBER_REGISTRATION_TTL=200000
EMBER_AUDIT_ROLE=false
EMBER_NODE_HEALTH=127.0.0.1:19192

# Local opt-in policy file; default requires governor endorsement for new profiles.
# Format: {"profiles":{"<profile-id>":{"publishers":["<account>"]}}}
# (implemented in lib/ember/node/agent/trust.py). The release bundles a
# ready-made example for the current profile as config/trust-policy.json
# in the installation root; point this variable at that file or your own pin.
EMBER_PROFILE_TRUST_POLICY=
